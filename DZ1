'''Ускорение работы с pandas

Считайте датасет из файла train.csv (это данные о выживаемости на Титанике) с помощью pandas

Посчитайте средний возраст пассажиров и его стандартное отклонение с помощью bottleneck - 1 балл

Для каждого пассажира умножьте значение столбца Fare на 1.3, если класс его билета - 1 или 2, и на 1.1, если класс его билета - 3. Сохраните результаты как новый столбец Fare_new. (При реализации расчета используйте любые альтернативы методу iterrows) - 1 балл
'''
import pandas as pd
import bottleneck as bn
import numpy as np

# Загрузка данных
df = pd.read_csv('train.csv')

# 1. Средний возраст с bottleneck
mean_age = bn.nanmean(df['Age'].values)
std_age = bn.nanstd(df['Age'].values)
print(f"Средний возраст: {mean_age:.2f} +- {std_age:.2f} лет")

# 2. Новая стоимость билета
df['Fare_new'] = df['Fare'] * np.where(df['Pclass'].isin([1, 2]), 1.3, 1.1)

print(df[['Pclass', 'Fare', 'Fare_new']])

'''
Оптимизация типов pandas

Считайте датасет из файла Housing.csv (это данные о ценах домов) с помощью pandas

Для каждого столбца определите оптимальный с точки зрения потребления памяти тип данных - напишите свои выводы в комментариях - 2 балла

Поменяйте типы данных столбцов датафрейма на выбранные вами в прошлом пункте и сравните потребление памяти до и после оптимизации - 1 балл
'''
import pandas as pd

# Загрузка данных
df = pd.read_csv('Housing.csv')

print("ДО оптимизации")
print(f"Память: {df.memory_usage(deep=True).sum() / 1024**2:.2f} MB")
print("Типы данных:")
print(df.dtypes)

# Анализ данных для выбора оптимальных типов
"""
1. price (13,300,000 - 1,750,000) -> int32 (хватит для чисел до 2 млрд)
2. area (16,200 - 1,650) -> int32
3. bedrooms (1-6), bathrooms (1-4), stories (1-4), parking (0-3) -> int8 (маленькие числа)
4. mainroad, guestroom, basement, hotwaterheating, airconditioning, prefarea -> bool (только yes/no)
5. furnishingstatus -> category (всего 3 варианта)
"""

# Меняем типы данных
df_opt = df.copy()

# Проводим смену по всем числовым столбцам
df_opt['price'] = df_opt['price'].astype('int32')
df_opt['area'] = df_opt['area'].astype('int32')
df_opt['bedrooms'] = df_opt['bedrooms'].astype('int8')
df_opt['bathrooms'] = df_opt['bathrooms'].astype('int8')
df_opt['stories'] = df_opt['stories'].astype('int8')
df_opt['parking'] = df_opt['parking'].astype('int8')

# Затем по всем логическим (булевым) столбцам
yes_no_cols = ['mainroad', 'guestroom', 'basement', 'hotwaterheating', 'airconditioning', 'prefarea']
for col in yes_no_cols:
    df_opt[col] = df_opt[col].map({'yes': True, 'no': False}).astype('bool')

# Столбец категорий
df_opt['furnishingstatus'] = df_opt['furnishingstatus'].astype('category')

print("\nПОСЛЕ оптимизации")
print(f"Память: {df_opt.memory_usage(deep=True).sum() / 1024**2:.2f} MB")
print("Типы данных:")
print(df_opt.dtypes)

# Сравнение
memory_before = df.memory_usage(deep=True).sum()
memory_after = df_opt.memory_usage(deep=True).sum()
reduction = (memory_before - memory_after) / memory_before * 100

print(f"Было: {memory_before / 1024**2:.2f} MB")
print(f"Стало: {memory_after / 1024**2:.2f} MB")
